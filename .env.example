# Server-side only (never prefix with NEXT_PUBLIC_)
RELAYER_PRIVATE_KEY=    # Wallet that calls setTokenURI
OPENAI_API_KEY=         # OpenAI API key for DALL·E 3
PINATA_JWT=             # Pinata JWT for IPFS pinning
SEPOLIA_RPC_URL=        # Alchemy/Infura Sepolia RPC URL
ETHERSCAN_API_KEY=      # Etherscan API key for source verification (free at etherscan.io)

# Admin secret for /api/reveal/retry (Task 3.5)
REVEAL_ADMIN_SECRET=     # Shared secret header value for retry endpoint

# Client-safe
NEXT_PUBLIC_CONTRACT_ADDRESS=0x3975572f325E14Ab87fE44957d9d697329b50438  # Deployed AffixNFT address (see apps/contracts/deployments/sepolia.json)
NEXT_PUBLIC_CHAIN_ID=11155111
NEXT_PUBLIC_RPC_URL=    # Public RPC for client-side tokenURI polling (e.g. https://rpc.sepolia.org or http://127.0.0.1:8545)

# Frontend gallery
NEXT_PUBLIC_DEPLOYMENT_BLOCK=10786249  # Block AffixNFT was deployed at; required to bound log scans
NEXT_PUBLIC_IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs/  # Public Pinata gateway. Override with your dedicated Pinata gateway for production.

# Optional: static ETH/USD fallback when the public rate API is blocked or fails (client-side)
# NEXT_PUBLIC_ETH_USD=3500
# WARNING: NEXT_PUBLIC_* values are inlined into the browser bundle. Do not set this in production.
# NEXT_PUBLIC_REVEAL_ADMIN_SECRET=
