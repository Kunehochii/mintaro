# Server-side only (never prefix with NEXT_PUBLIC_)
RELAYER_PRIVATE_KEY=    # Wallet that calls setTokenURI
OPENAI_API_KEY=         # OpenAI API key for DALL·E 3
PINATA_JWT=             # Pinata JWT for IPFS pinning
SEPOLIA_RPC_URL=        # Alchemy/Infura Sepolia RPC URL
ETHERSCAN_API_KEY=      # Etherscan API key for source verification (free at etherscan.io)

# Admin secret for /api/reveal/retry (Task 3.5)
REVEAL_ADMIN_SECRET=     # Shared secret header value for retry endpoint

# Client-safe
NEXT_PUBLIC_CONTRACT_ADDRESS=  # Deployed AffixNFT address
NEXT_PUBLIC_CHAIN_ID=11155111
NEXT_PUBLIC_RPC_URL=    # Public RPC for client-side tokenURI polling (e.g. https://rpc.sepolia.org or http://127.0.0.1:8545)
