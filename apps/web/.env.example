# ── Blockchain ──────────────────────────────────────────────
SEPOLIA_RPC_URL=
NEXT_PUBLIC_CONTRACT_ADDRESS=
NEXT_PUBLIC_DEPLOYMENT_BLOCK=

# ── Relayer (server-side, never expose to browser) ─────────
RELAYER_PRIVATE_KEY=

# ── OpenAI ─────────────────────────────────────────────────
OPENAI_API_KEY=

# ── Pinata / IPFS ──────────────────────────────────────────
PINATA_JWT=
# Optional: override the default IPFS gateway (https://ipfs.io/ipfs/)
# NEXT_PUBLIC_IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs/

# ── Admin (server-side) ───────────────────────────────────
REVEAL_ADMIN_SECRET=

# ── DEV ONLY — never set in production ────────────────────
# Powers the Dev Tools retry panel in the mint page.
# NEXT_PUBLIC_REVEAL_ADMIN_SECRET=
